# Public HTTP port on VPS
PORT=3001
BIND_ADDRESS=0.0.0.0
# Set to 1 when using HTTPS behind a reverse proxy.
COOKIE_SECURE=0
# Optional custom admin path (at least 12 characters after /). Otherwise a random path is stored in data/admin-route.txt.

# Optional analytics: disabled until your IDs are configured.
METRICA_ID=
GA4_ID=

# Optional private dispatcher bot. Set using: sudo bash deploy/setup-telegram.sh
# Never commit the real token/key. Both admins must press Start in the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_KEY=
TELEGRAM_ADMIN_IDS=6056397902,5673533667,923586346
